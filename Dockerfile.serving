FROM ghcr.io/astral-sh/uv:0.13.5 AS uv
FROM python:3.12.12-slim-bookworm

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --only-group serving
COPY src ./src
CMD ["/app/.venv/bin/uvicorn", "pad_hw.serving.api:app", "--host", "0.0.0.0", "--port", "8080"]
