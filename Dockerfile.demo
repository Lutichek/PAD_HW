FROM ghcr.io/astral-sh/uv:0.13.5 AS uv
FROM python:3.12.12-slim-bookworm

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --only-group demo
COPY src/pad_hw/demo ./src/pad_hw/demo
CMD ["/app/.venv/bin/uvicorn", "pad_hw.demo.app:app", "--host", "0.0.0.0", "--port", "7860"]
