# Пример настроек. `make s3-up` копирует этот файл в .env, если .env ещё нет.
# Реальный .env не коммитится (он в .gitignore).

# Учётные данные локального S3 (RustFS). Ими же логинимся в веб-консоль.
S3_ACCESS_KEY=pad-admin
S3_SECRET_KEY=pad-secret-change-me

# Бакет создаётся автоматически контейнером s3-init
S3_BUCKET=pad-hw
S3_REGION=us-east-1

# Порты на хосте: S3 API и веб-консоль
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Адрес S3 для Python-скриптов, запускаемых на хосте
S3_ENDPOINT_URL=http://localhost:9000
